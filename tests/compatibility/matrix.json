{
  "schema": 1,
  "family": "wp-social-ninja",
  "repositories": {
    "core": {
      "path": ".",
      "remote": "origin",
      "canonical": "github.com/wpmanageninja/wp-social-ninja",
      "current_branch": "development",
      "current_ref": "HEAD",
      "required_current_paths": [
        "tests/compatibility/runtime-cell.php"
      ]
    },
    "pro": {
      "path": "../wp-social-ninja-pro",
      "remote": "origin",
      "canonical": "github.com/wpmanageninja/wp-social-ninja-pro",
      "current_branch": "development",
      "current_ref": "HEAD",
      "required_current_paths": [
        "tests/addon.json",
        "tests/routes.json",
        "tests/cases/boot.php",
        "tests/cases/database.php",
        "tests/cases/public-surfaces.php",
        "tests/cases/routes.php"
      ]
    }
  },
  "constraints": {
    "core_requires_pro": {
      "range": ">=4.4.0",
      "source": {
        "plugin": "core",
        "file": "wp-social-reviews.php",
        "constant": "WPSOCIALREVIEWS_PRO_MIN_VERSION"
      }
    },
    "pro_requires_core": {
      "range": ">=4.4.0",
      "source": {
        "plugin": "pro",
        "file": "wp-social-ninja-pro.php",
        "constant": "WPSOCIALREVIEWS_CORE_MIN_VERSION"
      }
    },
    "wordpress": {
      "range": ">=6.2",
      "sources": [
        {
          "plugin": "core",
          "file": "readme.txt",
          "field": "Requires at least"
        },
        {
          "plugin": "pro",
          "file": "readme.txt",
          "field": "Requires at least"
        }
      ]
    },
    "php": {
      "range": ">=7.4",
      "sources": [
        {
          "plugin": "core",
          "file": "readme.txt",
          "field": "Requires PHP"
        },
        {
          "plugin": "pro",
          "file": "readme.txt",
          "field": "Requires PHP"
        }
      ]
    }
  },
  "artifacts": {
    "core-current": {
      "plugin": "core",
      "repository": ".",
      "ref": "HEAD",
      "version": "4.4.0",
      "kind": "current-checkout"
    },
    "pro-current": {
      "plugin": "pro",
      "repository": "../wp-social-ninja-pro",
      "ref": "HEAD",
      "version": "4.4.0",
      "kind": "current-checkout"
    },
    "core-below-min": {
      "plugin": "core",
      "repository": ".",
      "ref": "4.3.2",
      "version": "4.3.2",
      "kind": "historical-tag",
      "expected_commit": "930475a00e0f0c1a0762ef91946a94b59491b40d"
    },
    "pro-below-min": {
      "plugin": "pro",
      "repository": "../wp-social-ninja-pro",
      "ref": "4.3.1",
      "version": "4.3.1",
      "kind": "historical-tag",
      "expected_commit": "b4a34298b321b1d11d48ac7212c63e5030aa0000"
    }
  },
  "dimensions": {
    "current": {
      "wordpress_image": "wordpress:php8.2-apache",
      "cli_image": "wordpress:cli-php8.2",
      "php": "8.2",
      "wordpress": "current-image",
      "database_image": "mariadb:11.4"
    },
    "supported-minimum": {
      "wordpress_image": "wordpress:6.2-php8.0-apache",
      "cli_image": "wordpress:cli-php7.4",
      "php": "7.4",
      "wordpress": "6.2",
      "database_image": "mariadb:11.4"
    }
  },
  "cells": [
    {
      "id": "core-4-4-alone-current",
      "purpose": "current-free-alone",
      "core": "core-current",
      "pro": null,
      "dimension": "current",
      "expected": {
        "compatibility": "compatible",
        "core_boot": true,
        "pro_boot": false,
        "diagnostic": null,
        "core_routes_min": 1,
        "pro_route_declarations": 0,
        "lifecycle_checks_min": 5,
        "rest_checks_min": 2
      }
    },
    {
      "id": "core-4-4-pro-4-4-current",
      "purpose": "current-compatible-pair",
      "core": "core-current",
      "pro": "pro-current",
      "dimension": "current",
      "expected": {
        "compatibility": "compatible",
        "core_boot": true,
        "pro_boot": true,
        "diagnostic": null,
        "core_routes_min": 1,
        "pro_route_declarations": 33,
        "lifecycle_checks_min": 7,
        "rest_checks_min": 35
      }
    },
    {
      "id": "boundary-4-4-pair-wp-6-2-php-7-4",
      "purpose": "declared-minimum-boundary-pair",
      "core": "core-current",
      "pro": "pro-current",
      "dimension": "supported-minimum",
      "expected": {
        "compatibility": "compatible",
        "core_boot": true,
        "pro_boot": true,
        "diagnostic": null,
        "core_routes_min": 1,
        "pro_route_declarations": 33,
        "lifecycle_checks_min": 7,
        "rest_checks_min": 35
      }
    },
    {
      "id": "pro-4-4-rejects-core-4-3-2",
      "purpose": "below-minimum-core-for-pro",
      "core": "core-below-min",
      "pro": "pro-current",
      "dimension": "current",
      "expected": {
        "compatibility": "incompatible",
        "core_boot": true,
        "pro_boot": false,
        "diagnostic": "WP Social Ninja Pro requires WP Social Ninja version 4.4.0 or higher",
        "core_routes_min": 1,
        "pro_route_declarations": 0,
        "lifecycle_checks_min": 6,
        "rest_checks_min": 2
      }
    },
    {
      "id": "core-4-4-rejects-pro-4-3-1",
      "purpose": "below-minimum-pro-for-core",
      "core": "core-current",
      "pro": "pro-below-min",
      "dimension": "current",
      "expected": {
        "compatibility": "incompatible",
        "core_boot": true,
        "pro_boot": false,
        "diagnostic": "displayProUpdateNotice=true",
        "core_routes_min": 1,
        "pro_route_declarations": 0,
        "lifecycle_checks_min": 6,
        "rest_checks_min": 2
      }
    }
  ],
  "historical_unavailable": []
}
